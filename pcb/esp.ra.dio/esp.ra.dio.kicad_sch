		(uuid "36ee405c-48fb-41ff-a79f-bcf3fad34216")
	)
	(text_box "GPIO2, GPIO8, GPIO9 used in strapping\nGPIO2, GPIO8 float. GPIO9 has weak int. pullup\nJoint download mode requires\nGPIO2=1 GPIO8=1 GPIO9=0\nR6,R7 pullup GPIO2,8 always\nButton sinks GPIO9 to 0 for boot\nWeak pullups only help the pins' normal common GND button behaviour"
		(exclude_from_sim no)
		(at 222.25 91.44 0)
		(size 50.8 17.78)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
