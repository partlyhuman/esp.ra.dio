				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "4ada5e0c-7d1e-4361-aef6-4619435fa840")
	)
	(text_box "In dev board config, USB can power.\nEngineer must prevent backpowering batt by keeping switch off."
		(exclude_from_sim no)
		(at 74.93 30.48 0)
		(size 39.37 7.62)
		(margins 0.9525 0.9525 0.9525 0.9525)
